{
  "name": "toolverse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "prerender": "node scripts/prerender.mjs",
    "prebuild": "node scripts/generate-sitemap.mjs",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name=toolverse-app --commit-dirty=true",
    "cf:check": "node -e \"console.log('Use: npm run build → output dist. Project: toolverse-app')\"",
    "test": "vitest run tests/",
    "seo:all": "node seo/runSeoEngine.mjs",
    "seo:crawl": "node -e \"import('./seo/crawler/siteCrawler.mjs').then(m => m.runSiteCrawler())\"",
    "seo:audit": "node -e \"import('./seo/audit/technicalAuditor.mjs').then(m => m.runTechnicalAudit())\"",
    "seo:accessibility": "node -e \"import('./seo/audit/accessibilityAuditor.mjs').then(m => m.runAccessibilityAudit())\"",
    "seo:keywords": "node -e \"import('./seo/keywords/keywordEngine.mjs').then(m => m.runKeywordEngine())\"",
    "seo:content": "node -e \"import('./seo/content/contentGapEngine.mjs').then(m => m.runContentGapEngine())\"",
    "seo:links": "node -e \"import('./seo/internal-links/linkGraphEngine.mjs').then(m => m.runLinkGraphEngine())\"",
    "seo:backlinks": "node -e \"import('./seo/backlinks/backlinkEngine.mjs').then(m => m.runBacklinkEngine())\"",
    "seo:report": "node -e \"import('./seo/reports/reportGenerator.mjs').then(m => m.runReportGenerator())\""
  },
  "dependencies": {
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.4.3",
    "diff": "^7.0.0",
    "dompurify": "^3.1.7",
    "heic2any": "^0.0.4",
    "js-yaml": "^4.1.0",
    "jsbarcode": "^3.11.6",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.453.0",
    "papaparse": "^5.4.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.4",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/diff": "^5.2.3",
    "@types/dompurify": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.17.0",
    "@types/papaparse": "^5.3.15",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.3",
    "wrangler": "^3.99.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.63.5"
  }
}
